{
	"info": {
		"_postman_id": "testing-pro-grocery-api-v2",
		"name": "Testing Pro - Bilingual Grocery REST API Collection (with Settings, Roles, Forgot Password)",
		"description": "Complete REST API collection for the Bilingual (English & Gujarati) Grocery Platform with OTP Auth, Forgot Password flow, Roles & Permissions, Categories, Products, Delivery Slot (2 Hours vs Next Day), Cart, Wishlist, Leaflet Map Addresses, Orders, and Settings. Auth: OTP login + sign-up (register -> verify), resend with cool-down, password reset by e-mail or SMS.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "locale",
			"value": "gu",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication & Password Reset",
			"item": [
				{
					"name": "Register (Sign up) - Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "{{locale}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Riya Shah\",\n    \"phone\": \"9123456780\",\n    \"email\": \"riya@example.com\",\n    \"language\": \"gu\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Starts a sign-up: stores the details for a few minutes and sends a register OTP by SMS. 422 with `already_registered: true` if the phone exists. `data.demo_otp` is present only in demo mode (SMS_DRIVER=log). Finish with **Verify OTP** - it creates the account and returns a token."
					}
				},
				{
					"name": "Send OTP (Mobile Login)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "{{locale}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"9876543210\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/otp/send",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"otp",
								"send"
							]
						},
						"description": "Sends a login OTP to a registered mobile. Unregistered phone -> 404 `{success:false, needs_registration:true, message}` (call Register instead). Within the resend cool-down while a code is still valid it returns 200 again with `data.resend_in`. `data.demo_otp` only in demo mode."
					}
				},
				{
					"name": "Resend OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "{{locale}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"9123456780\",\n    \"purpose\": \"login\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/otp/resend",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"otp",
								"resend"
							]
						},
						"description": "purpose: login | register | reset. 429 `{reason:'cooldown', retry_after}` during the cool-down (OTP_RESEND_SECONDS) or `{reason:'hourly_limit'}` after OTP_MAX_PER_HOUR codes."
					}
				},
				{
					"name": "Verify OTP & Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var j = pm.response.json();",
									"var t = (j.data && j.data.token) || j.token;",
									"if (t) { pm.collectionVariables.set('auth_token', t); }"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Accept-Language",
								"value": "{{locale}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"9876543210\",\n    \"otp\": \"1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/otp/verify",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"otp",
								"verify"
							]
						},
						"description": "Verifies the code (purpose auto-detected: pending sign-up -> creates the account, else login). Returns `data.token`, `data.user`, `data.is_new_user`. Wrong code -> 422 `{reason:'invalid', attempts_left}`; after OTP_MAX_ATTEMPTS the code is discarded (`too_many_attempts`); expired -> `expired`."
					}
				},
				{
					"name": "Forgot Password - Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email_or_phone\": \"admin@grocery.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/forgot-password/send-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"forgot-password",
								"send-otp"
							]
						},
						"description": "email_or_phone: e-mail -> branded e-mail with the code + one-click reset link; 10-digit phone -> SMS. Always answers 200 with the same message whether or not the account exists."
					}
				},
				{
					"name": "Forgot Password - Reset with OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email_or_phone\": \"admin@grocery.com\",\n    \"otp\": \"1234\",\n    \"password\": \"NewSecret#2026\",\n    \"password_confirmation\": \"NewSecret#2026\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/forgot-password/reset",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"forgot-password",
								"reset"
							]
						},
						"description": "Verifies the reset OTP and sets the new password (min 8; password_confirmation optional but must match when sent). Revokes all API tokens of the user."
					}
				},
