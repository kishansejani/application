APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# E-mail (password-reset codes). MAIL_MAILER=log only writes mails to
# storage/logs/laravel.log - nothing is delivered. To send real e-mail use SMTP:
#
#   Gmail (needs 2-Step Verification + an App Password from
#   https://myaccount.google.com/apppasswords - your normal password will NOT work):
#     MAIL_MAILER=smtp
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_SCHEME=smtp            # 587 = STARTTLS -> "smtp";  465 = SSL -> "smtps"
#     MAIL_USERNAME=yourname@gmail.com
#     MAIL_PASSWORD="abcd efgh ijkl mnop"   # the 16-letter App Password
#     MAIL_FROM_ADDRESS="yourname@gmail.com"
#     MAIL_FROM_NAME="Fresh Express"
#
#   Laravel 12 note: MAIL_SCHEME accepts only "smtp" or "smtps" (or null = pick by
#   port). The old MAIL_ENCRYPTION=tls / MAIL_SCHEME=tls values are NOT valid.
#   Other providers: Brevo smtp-relay.brevo.com:587, Zoho smtp.zoho.in:465 (smtps),
#   Mailtrap sandbox.smtp.mailtrap.io:2525 (testing inbox).
#
#   After changing: php artisan config:clear && php artisan mail:test you@example.com
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Fresh Express"

# ---------------------------------------------------------------------------
# SMS gateway for one-time codes (login, sign-up, password reset)
#   log      - development: the SMS text is written to storage/logs/laravel.log
#   twilio   - worldwide        https://console.twilio.com
#   msg91    - India (DLT)      https://control.msg91.com  (Flow/OTP template)
#   fast2sms - India            https://www.fast2sms.com/dashboard/dev-api
#   2factor  - India            https://2factor.in
# Indian numbers: commercial SMS needs a DLT-registered sender id + template;
# fast2sms route=otp and 2factor work without your own DLT registration.
# After changing: php artisan config:clear
# ---------------------------------------------------------------------------
SMS_DRIVER=log
SMS_COUNTRY_CODE=91
SMS_SENDER_ID=FRSHEX
# SMS_OTP_MESSAGE=":code is your Fresh Express verification code. It is valid for :minutes minutes. Do not share it with anyone."

# Twilio: Account SID, Auth Token, and a Twilio number (+1...) or Messaging Service SID (MG...)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# MSG91: Auth key + Flow template id; the template must contain ##otp## (see MSG91_OTP_VARIABLE)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=otp

# Fast2SMS: API key from Dev API page. FAST2SMS_ROUTE=otp (no DLT) | dlt (+FAST2SMS_TEMPLATE_ID) | q
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
FAST2SMS_TEMPLATE_ID=

# 2Factor: API key; optional OTP template name created in the 2Factor panel
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=

# ---------------------------------------------------------------------------
# One-time codes
# ---------------------------------------------------------------------------
OTP_LENGTH=4              # digits (the code screens draw one box per digit)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5        # wrong guesses before the code is discarded
OTP_RESEND_SECONDS=30     # cool-down before "Resend code" is allowed
OTP_MAX_PER_HOUR=5        # codes per phone / e-mail per hour
# Demo mode uses the fixed code 1234 and shows it on screen. It defaults to ON
# only while SMS_DRIVER=log, and is ignored for any real SMS gateway / SMTP server.
# OTP_DEMO_MODE=true
# OTP_DEMO_CODE=1234

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
